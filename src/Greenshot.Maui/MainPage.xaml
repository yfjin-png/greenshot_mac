<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{AppThemeBinding Light=#F4FAF5, Dark=#111713}"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             x:Class="Greenshot.Maui.MainPage">

    <ContentPage.Resources>
        <Style x:Key="CompactToolButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="34" />
        </Style>
        <Style x:Key="CompactNavButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="34" />
            <Setter Property="MinimumWidthRequest" Value="34" />
        </Style>
        <Style x:Key="CompactFieldBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F5FBF7, Dark=#111A14}" />
        </Style>
        <Style x:Key="CompactToolbarFieldStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F8FCF8, Dark=#0E1410}" />
        </Style>
        <Style x:Key="ChipBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 999" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EAF8F1, Dark=#163223}" />
        </Style>
        <Style x:Key="MacMenuButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#173525, Dark=#F0FFF6}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="Shadow" Value="{x:Null}" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.MenuBarItems>
        <MenuBarItem x:Name="FileMenuBarItem" Text="File">
            <MenuFlyoutItem x:Name="OpenImageMenuItem"
                            Text="Open Image..."
                            Clicked="OnOpenImageClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Cmd" Key="O" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
        </MenuBarItem>
        <MenuBarItem x:Name="CaptureMenuBarItem" Text="Capture">
            <MenuFlyoutItem x:Name="CaptureScreenMenuItem"
                            Text="Capture Screen"
                            Clicked="OnCaptureScreenClicked" />
            <MenuFlyoutItem x:Name="CaptureWindowMenuItem"
                            Text="Capture Window"
                            Clicked="OnCaptureWindowClicked" />
            <MenuFlyoutItem x:Name="CaptureRegionMenuItem"
                            Text="Capture Region"
                            Clicked="OnCaptureRegionClicked" />
        </MenuBarItem>
        <MenuBarItem x:Name="ImageMenuBarItem" Text="Image">
            <MenuFlyoutItem x:Name="EditImageMenuItem"
                            Text="Edit Image"
                            Clicked="OnEditImageClicked" />
            <MenuFlyoutItem x:Name="CopyToClipboardMenuItem"
                            Text="Copy to Clipboard"
                            Clicked="OnCopyToClipboardClicked" />
            <MenuFlyoutItem x:Name="CopyPathMenuItem"
                            Text="Copy Path"
                            Clicked="OnCopyPathClicked" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="ClearImageMenuItem"
                            Text="Clear Image"
                            Clicked="OnClearImageClicked" />
        </MenuBarItem>
        <MenuBarItem x:Name="SelectionMenuBarItem" Text="Selection">
            <MenuFlyoutItem x:Name="ApplySelectionMenuItem"
                            Text="Capture Selection"
                            Clicked="OnApplySelectionClicked" />
            <MenuFlyoutItem x:Name="CancelSelectionMenuItem"
                            Text="Cancel Selection"
                            Clicked="OnCancelSelectionClicked" />
        </MenuBarItem>
        <MenuBarItem x:Name="EditorMenuBarItem" Text="Editor">
            <MenuFlyoutItem x:Name="SaveEditedCopyMenuItem"
                            Text="Save Copy"
                            Clicked="OnSaveEditedCopyClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Cmd" Key="S" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="CloseEditorMenuItem"
                            Text="Close Editor"
                            Clicked="OnCloseEditorClicked" />
        </MenuBarItem>
        <MenuBarItem x:Name="NavigateMenuBarItem" Text="Navigate">
            <MenuFlyoutItem x:Name="PreviousImageMenuItem"
                            Text="Previous Image"
                            Clicked="OnPreviousImageClicked" />
            <MenuFlyoutItem x:Name="NextImageMenuItem"
                            Text="Next Image"
                            Clicked="OnNextImageClicked" />
        </MenuBarItem>
        <MenuBarItem x:Name="WindowMenuBarItem" Text="Window">
            <MenuFlyoutItem x:Name="ShowPreviewMenuItem"
                            Text="Show Preview"
                            Clicked="OnShowPreviewMenuItemClicked" />
        </MenuBarItem>
    </ContentPage.MenuBarItems>

    <ScrollView>
        <VerticalStackLayout Padding="24,18,24,28" Spacing="18">
            <Border Padding="18" StrokeShape="RoundRectangle 24" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#171E1A}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="8">
                                <Border Style="{StaticResource ChipBorderStyle}">
                                    <Label x:Name="PlatformValueLabel"
                                           FontSize="12"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light=#22523A, Dark=#DDF5E8}" />
                                </Border>
                                <Border Style="{StaticResource ChipBorderStyle}">
                                    <Label x:Name="StatusValueLabel"
                                           FontSize="12"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light=#22523A, Dark=#DDF5E8}" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label x:Name="SelectedImageLabel"
                                   FontSize="20"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light=#173525, Dark=#F0FFF6}" />
                            <Label x:Name="WorkspaceHintLabel"
                                   FontSize="13"
                                   LineHeight="1.35"
                                   TextColor="{AppThemeBinding Light=#557565, Dark=#9FB9A9}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="8"
                                             HorizontalOptions="End">
                            <Picker x:Name="WorkspaceMenuPicker"
                                    Title="Capture / File"
                                    IsVisible="{OnPlatform MacCatalyst=False, Default=True}"
                                    WidthRequest="180"
                                    HorizontalOptions="End"
                                    SelectedIndexChanged="OnWorkspaceMenuSelectionChanged" />
                            <Button x:Name="WorkspaceMenuButton"
                                    IsVisible="{OnPlatform MacCatalyst=True, Default=False}"
                                    HorizontalOptions="End"
                                    Clicked="OnWorkspaceMenuButtonClicked"
                                    Style="{StaticResource MacMenuButtonStyle}"
                                    Text="Menu v" />
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                                <Label x:Name="PreviewHistoryLabel"
                                       VerticalTextAlignment="Center"
                                       FontSize="12"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light=#557565, Dark=#9FB9A9}" />
                                <Button x:Name="PreviousImageButton"
                                        Text="Back"
                                        Clicked="OnPreviousImageClicked"
                                        IsEnabled="False"
                                        Style="{StaticResource CompactNavButtonStyle}" />
                                <Button x:Name="NextImageButton"
                                        Text="Next"
                                        Clicked="OnNextImageClicked"
                                        IsEnabled="False"
                                        Style="{StaticResource CompactNavButtonStyle}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <Border x:Name="SelectionInstructionPanel"
                            Padding="12"
                            IsVisible="False"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light=#EAF8F1, Dark=#133525}">
                        <Label x:Name="SelectionInstructionLabel"
                               FontSize="13"
                               LineHeight="1.35"
                               TextColor="{AppThemeBinding Light=#22523A, Dark=#DDF5E8}" />
                    </Border>

                    <Border Padding="14" StrokeShape="RoundRectangle 20" BackgroundColor="{AppThemeBinding Light=#F8FCF8, Dark=#0E1410}">
                        <Grid x:Name="PreviewStage" MinimumHeightRequest="300">
                            <Image x:Name="PreviewImage" Aspect="AspectFit" IsVisible="False">
                                <Image.GestureRecognizers>
                                    <PointerGestureRecognizer PointerPressed="OnPreviewPointerPressed" />
                                </Image.GestureRecognizers>
                            </Image>
                            <AbsoluteLayout x:Name="EditorAnnotationLayer"
                                            IsVisible="False"
                                            InputTransparent="True" />
                            <AbsoluteLayout x:Name="EditorInputOverlay" IsVisible="False">
                                <AbsoluteLayout.GestureRecognizers>
                                    <PointerGestureRecognizer PointerEntered="OnEditorPointerEntered"
                                                              PointerExited="OnEditorPointerExited"
                                                              PointerPressed="OnEditorPointerPressed"
                                                              PointerMoved="OnEditorPointerMoved"
                                                              PointerReleased="OnEditorPointerReleased" />
                                </AbsoluteLayout.GestureRecognizers>
                                <ContentView x:Name="EditorCursorIndicator"
                                             IsVisible="False"
                                             InputTransparent="True"
                                             AbsoluteLayout.LayoutBounds="0,0,24,24">
                                    <Grid WidthRequest="24" HeightRequest="24">
                                        <BoxView WidthRequest="2"
                                                 HeightRequest="24"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Color="#E6F6FFF9" />
                                        <BoxView WidthRequest="24"
                                                 HeightRequest="2"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Color="#E6F6FFF9" />
                                        <Border WidthRequest="8"
                                                HeightRequest="8"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                InputTransparent="True"
                                                Stroke="#D56A2F"
                                                StrokeThickness="2"
                                                BackgroundColor="#B20E1410"
                                        StrokeShape="RoundRectangle 999" />
                                    </Grid>
                                </ContentView>
                            </AbsoluteLayout>
                            <AbsoluteLayout x:Name="InlineTextEditorOverlay"
                                            IsVisible="False"
                                            ZIndex="10">
                                <Border x:Name="InlineTextEditorHost"
                                        IsVisible="False"
                                        Padding="12,8"
                                        StrokeThickness="0"
                                        BackgroundColor="Transparent"
                                        AbsoluteLayout.LayoutBounds="0,0,0,0">
                                    <Editor x:Name="InlineTextEditor"
                                            BackgroundColor="Transparent"
                                            AutoSize="TextChanges"
                                            TextChanged="OnInlineTextEditorTextChanged"
                                            Unfocused="OnInlineTextEditorUnfocused" />
                                </Border>
                            </AbsoluteLayout>
                            <AbsoluteLayout x:Name="SelectionOverlay" IsVisible="False">
                                <BoxView x:Name="SelectionInputSurface"
                                         Color="#01000000"
                                         AbsoluteLayout.LayoutBounds="0,0,1,1"
                                         AbsoluteLayout.LayoutFlags="All">
                                    <BoxView.GestureRecognizers>
                                        <PointerGestureRecognizer PointerEntered="OnSelectionPointerEntered"
                                                                  PointerExited="OnSelectionPointerExited"
                                                                  PointerPressed="OnSelectionPointerPressed"
                                                                  PointerMoved="OnSelectionPointerMoved"
                                                                  PointerReleased="OnSelectionPointerReleased" />
                                    </BoxView.GestureRecognizers>
                                </BoxView>
                                <Border x:Name="SelectionBox"
                                        IsVisible="False"
                                        InputTransparent="True"
                                        Stroke="#15875C"
                                        StrokeThickness="2"
                                        BackgroundColor="#3315875C"
                                        StrokeShape="RoundRectangle 6"
                                        AbsoluteLayout.LayoutBounds="0,0,0,0" />
                                <ContentView x:Name="SelectionCursorIndicator"
                                             IsVisible="False"
                                             InputTransparent="True"
                                             AbsoluteLayout.LayoutBounds="0,0,24,24">
                                    <Grid WidthRequest="24" HeightRequest="24">
                                        <BoxView WidthRequest="2"
                                                 HeightRequest="24"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Color="#E6F6FFF9" />
                                        <BoxView WidthRequest="24"
                                                 HeightRequest="2"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Color="#E6F6FFF9" />
                                        <Border WidthRequest="8"
                                                HeightRequest="8"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                InputTransparent="True"
                                                Stroke="#15875C"
                                                StrokeThickness="2"
                                                BackgroundColor="#B20E1410"
                                                StrokeShape="RoundRectangle 999" />
                                    </Grid>
                                </ContentView>
                            </AbsoluteLayout>
                            <VerticalStackLayout x:Name="EmptyStatePanel" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="No screenshot loaded yet"
                                       FontSize="18"
                                       FontFamily="OpenSansSemibold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#204432, Dark=#E1F6E8}" />
                                <Label Text="Open an existing PNG or JPEG to validate the new MAUI shell and file workflow."
                                       FontSize="13"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#587767, Dark=#9EB8A8}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <HorizontalStackLayout x:Name="SelectionActionsPanel" Spacing="10" IsVisible="False">
                        <Button x:Name="ApplySelectionButton" Text="Capture Selection" IsEnabled="False" Clicked="OnApplySelectionClicked" />
                        <Button Text="Cancel Selection" Clicked="OnCancelSelectionClicked" />
                    </HorizontalStackLayout>

                    <Border x:Name="SettingsPanel"
                            Padding="18"
                            IsVisible="False"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{AppThemeBinding Light=#F5FBF7, Dark=#111A14}">
                        <VerticalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Settings"
                                       FontSize="20"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light=#173525, Dark=#F0FFF6}" />
                                <Label Text="Configure the default behavior for captures launched from the menu bar icon."
                                       FontSize="13"
                                       LineHeight="1.35"
                                       TextColor="{AppThemeBinding Light=#557565, Dark=#9FB9A9}" />
                            </VerticalStackLayout>

                            <Border Style="{StaticResource CompactFieldBorderStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Save captures to local storage by default"
                                               FontSize="14"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{AppThemeBinding Light=#173525, Dark=#F0FFF6}" />
                                        <Label Text="Captured images are still created in the app cache first. When this is enabled, they are also copied into your chosen folder."
                                               FontSize="12"
                                               LineHeight="1.35"
                                               TextColor="{AppThemeBinding Light=#557565, Dark=#9FB9A9}" />
                                    </VerticalStackLayout>
                                    <Switch x:Name="SettingsSaveToLocalSwitch"
                                            Grid.Column="1"
                                            VerticalOptions="Center"
                                            Toggled="OnSettingsSaveToLocalToggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CompactFieldBorderStyle}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Local save folder"
                                           FontSize="14"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light=#173525, Dark=#F0FFF6}" />
                                    <Entry x:Name="SettingsSaveLocationEntry"
                                           Placeholder="/Users/you/Pictures/Greenshot"
                                           ClearButtonVisibility="WhileEditing" />
                                    <HorizontalStackLayout Spacing="10">
                                        <Button x:Name="SettingsChooseFolderButton"
                                                IsVisible="False"
                                                Text="Choose Folder"
                                                Clicked="OnChooseCaptureFolderClicked" />
                                        <Button x:Name="SettingsUseDefaultFolderButton"
                                                Text="Use Default Folder"
                                                Clicked="OnUseDefaultCaptureFolderClicked" />
                                        <Label x:Name="SettingsDefaultFolderLabel"
                                               VerticalTextAlignment="Center"
                                               FontSize="12"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light=#557565, Dark=#9FB9A9}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Border Style="{StaticResource CompactFieldBorderStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Copy captures to the clipboard by default"
                                               FontSize="14"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{AppThemeBinding Light=#173525, Dark=#F0FFF6}" />
                                        <Label Text="After a successful capture, the final image is copied to the clipboard automatically."
                                               FontSize="12"
                                               LineHeight="1.35"
                                               TextColor="{AppThemeBinding Light=#557565, Dark=#9FB9A9}" />
                                    </VerticalStackLayout>
                                    <Switch x:Name="SettingsCopyToClipboardSwitch"
                                            Grid.Column="1"
                                            VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Save Settings" Clicked="OnSaveSettingsClicked" />
                                <Button Text="Close" Clicked="OnCloseSettingsClicked" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="EditorToolPanel"
                            Padding="12"
                            IsVisible="False"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{AppThemeBinding Light=#F5FBF7, Dark=#111A14}">
                        <VerticalStackLayout Spacing="10">
                            <FlexLayout Wrap="Wrap"
                                        Direction="Row"
                                        AlignItems="Center"
                                        JustifyContent="Start">
                                <Button x:Name="EditorPencilButton" Style="{StaticResource CompactToolButtonStyle}" Text="Pencil" Clicked="OnPencilToolClicked" />
                                <Button x:Name="EditorRectangleButton" Style="{StaticResource CompactToolButtonStyle}" Text="Rectangle" Clicked="OnRectangleToolClicked" />
                                <Button x:Name="EditorArrowButton" Style="{StaticResource CompactToolButtonStyle}" Text="Arrow" Clicked="OnArrowToolClicked" />
                                <Button x:Name="EditorLineButton" Style="{StaticResource CompactToolButtonStyle}" Text="Line" Clicked="OnLineToolClicked" />
                                <Button x:Name="EditorHighlightButton" Style="{StaticResource CompactToolButtonStyle}" Text="Highlight" Clicked="OnHighlightToolClicked" />
                                <Button x:Name="EditorTextButton" Style="{StaticResource CompactToolButtonStyle}" Text="Text" Clicked="OnTextToolClicked" />
                                <Button x:Name="EditorCalloutButton" Style="{StaticResource CompactToolButtonStyle}" Text="Callout" Clicked="OnCalloutToolClicked" />
                                <Button x:Name="EditorPasteButton" Style="{StaticResource CompactToolButtonStyle}" Text="Paste" Clicked="OnPasteFromClipboardClicked" />
                                <Button x:Name="EditorUndoButton" Style="{StaticResource CompactToolButtonStyle}" Text="Undo" Clicked="OnUndoAnnotationClicked" />
                                <Button x:Name="EditorSaveButton" Style="{StaticResource CompactToolButtonStyle}" Text="Save Copy" Clicked="OnSaveEditedCopyClicked" />
                                <Button x:Name="EditorCloseButton" Style="{StaticResource CompactToolButtonStyle}" Text="Close" Clicked="OnCloseEditorClicked" />
                            </FlexLayout>
                            <FlexLayout x:Name="EditorStylePanel"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        AlignItems="Center"
                                        JustifyContent="Start">
                                <Border x:Name="EditorStrokeColorPanel" Style="{StaticResource CompactToolbarFieldStyle}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Stroke" FontSize="11" TextColor="{AppThemeBinding Light=#557565, Dark=#9FB9A9}" />
                                        <Picker x:Name="EditorStrokeColorPicker"
                                                WidthRequest="138"
                                                HeightRequest="34"
                                                Title="Stroke color"
                                                SelectedIndexChanged="OnEditorStrokeColorChanged" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border x:Name="EditorFillColorPanel" Style="{StaticResource CompactToolbarFieldStyle}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label x:Name="EditorFillColorLabel" Text="Fill / background" FontSize="11" TextColor="{AppThemeBinding Light=#557565, Dark=#9FB9A9}" />
                                        <Picker x:Name="EditorFillColorPicker"
                                                WidthRequest="138"
                                                HeightRequest="34"
                                                Title="Fill or background color"
                                                SelectedIndexChanged="OnEditorFillColorChanged" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border x:Name="EditorStrokeStylePanel" Style="{StaticResource CompactToolbarFieldStyle}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Style" FontSize="11" TextColor="{AppThemeBinding Light=#557565, Dark=#9FB9A9}" />
                                        <Picker x:Name="EditorStrokeStylePicker"
                                                WidthRequest="124"
                                                HeightRequest="34"
                                                Title="Stroke style"
                                                SelectedIndexChanged="OnEditorStrokeStyleChanged" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border x:Name="EditorTextColorPanel" Style="{StaticResource CompactToolbarFieldStyle}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Text color" FontSize="11" TextColor="{AppThemeBinding Light=#557565, Dark=#9FB9A9}" />
                                        <Picker x:Name="EditorTextColorPicker"
                                                WidthRequest="124"
                                                HeightRequest="34"
                                                Title="Text color"
                                                SelectedIndexChanged="OnEditorTextColorChanged" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border x:Name="EditorStrokeThicknessPanel" Style="{StaticResource CompactToolbarFieldStyle}">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="Stroke size" FontSize="11" TextColor="{AppThemeBinding Light=#557565, Dark=#9FB9A9}" />
                                            <Label x:Name="EditorStrokeThicknessValueLabel"
                                                   FontSize="11"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="{AppThemeBinding Light=#173525, Dark=#F0FFF6}" />
                                        </Grid>
                                        <Slider x:Name="EditorStrokeThicknessSlider"
                                                WidthRequest="138"
                                                Minimum="1"
                                                Maximum="16"
                                                ThumbColor="#15875C"
                                                MinimumTrackColor="#15875C"
                                                MaximumTrackColor="#CFEFDD"
                                                ValueChanged="OnEditorStrokeThicknessChanged" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border x:Name="EditorTextSizePanel" Style="{StaticResource CompactToolbarFieldStyle}">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="Text size" FontSize="11" TextColor="{AppThemeBinding Light=#557565, Dark=#9FB9A9}" />
                                            <Label x:Name="EditorTextSizeValueLabel"
                                                   FontSize="11"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="{AppThemeBinding Light=#173525, Dark=#F0FFF6}" />
                                        </Grid>
                                        <Slider x:Name="EditorTextSizeSlider"
                                                WidthRequest="138"
                                                Minimum="10"
                                                Maximum="48"
                                                ThumbColor="#15875C"
                                                MinimumTrackColor="#15875C"
                                                MaximumTrackColor="#CFEFDD"
                                                ValueChanged="OnEditorTextSizeChanged" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border x:Name="EditorTextContentPanel" Style="{StaticResource CompactToolbarFieldStyle}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label x:Name="EditorTextContentLabel"
                                               Text="Text"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light=#557565, Dark=#9FB9A9}" />
                                        <Entry x:Name="EditorTextInput"
                                               WidthRequest="180"
                                               HeightRequest="34"
                                               Placeholder="Annotation text"
                                               TextChanged="OnEditorTextChanged" />
                                    </VerticalStackLayout>
                                </Border>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
